# OpenRouter API Key and Default Model
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
OPENROUTER_DEFAULT_MODEL="openrouter/free"

# Firecrawl API Key (Optional: for live web search and scraping in Plan/Ask modes...)
FIRECRAWL_API_KEY="fc-your-key-here"

# Telegram Bot Credentials (Optional: required only for Telegram Bot Mode...)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
TELEGRAM_OWNER_ID="your-telegram-numeric-user-id"
